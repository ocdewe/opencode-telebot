[Unit]
Description=Telegram Bot - OpenCode Remote
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/telegram-remote
Environment=PATH=/root/.opencode/bin:/usr/bin:/usr/local/bin:/bin
Environment=NODE_ENV=production
ExecStart=/usr/bin/npx tsx src/index.ts
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
