# Telegram Bot Token (dari @BotFather)
BOT_TOKEN=your_bot_token_here

# User ID yang boleh akses bot (dari @userinfobot atau /id)
# Pisahkan dengan koma kalau lebih dari satu
ALLOWED_USER_IDS=123456789

# Path ke OpenCode executable
# Windows: biasanya C:\ProgramData\chocolatey\bin\opencode.exe atau opencode
# Linux: biasanya /usr/local/bin/opencode atau ~/.opencode/bin/opencode
OPENCODE_PATH=opencode

# Default working directory
# Windows: C:\Projects\my-project
# Linux: /home/user/projects
WORK_DIR=/path/to/your/project

# Default model (sesuaikan dengan provider di opencode.json)
DEFAULT_MODEL=your-provider/model-name
